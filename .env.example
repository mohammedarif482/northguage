# Public site URL (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://northgauge.com

# Audit form delivery via Resend (https://resend.com). Without a key, dev logs leads to the console
# and production returns an error asking visitors to email instead.
RESEND_API_KEY=
AUDIT_INBOX_EMAIL=hello@northgauge.com
AUDIT_FROM_EMAIL="Northgauge Audits <audits@northgauge.com>"

# Optional: direct booking link shown after the form is submitted (Cal.com / Calendly)
NEXT_PUBLIC_BOOKING_URL=

# Optional: Plausible analytics domain. Only loads after the visitor accepts cookies.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
