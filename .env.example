# Public site URL (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://northgauge.com

# Cal.com booking for the "See if you're a fit" sections, as "username/event-slug".
# Add booking questions on the Cal.com event to match the spec's fit check: country, WhatsApp number,
# monthly ad spend band, and "Where does it hurt?". Bookings carry metadata[source] and metadata[region].
NEXT_PUBLIC_CAL_LINK=
# Optional: separate events for the Media Buying ad account audit and the Hook OS creative teardown.
# Fall back to NEXT_PUBLIC_CAL_LINK when empty.
NEXT_PUBLIC_CAL_LINK_MEDIA_BUYING=
NEXT_PUBLIC_CAL_LINK_HOOK_OS=

# Optional: Plausible analytics domain. Only loads after the visitor accepts cookies.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
